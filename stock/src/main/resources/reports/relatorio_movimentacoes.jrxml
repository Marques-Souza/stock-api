    <style name="Detail" mode="Opaque" fontName="Arial" fontSize="9" forecolor="#334155" backcolor="#F8FAFC" pdfFontName="Helvetica">
        <box>
            <pen lineWidth="0.35" lineColor="#E2E8F0"/>
        </box>
    </style>
    <style name="ColumnHeader" mode="Opaque" fontName="Arial" fontSize="9" isBold="true" forecolor="#FFFFFF" backcolor="#1F3A5F" pdfFontName="Helvetica-Bold"/>
    <parameter name="REPORT_TITLE" class="java.lang.String">
        <defaultValueExpression><![CDATA["Relatório de Movimentações de Estoque"]]></defaultValueExpression>
    </parameter>
    <parameter name="GENERATED_AT" class="java.lang.String"/>
    <parameter name="TYPE" class="java.lang.String"/>
    <parameter name="START_DATE" class="java.sql.Timestamp"/>
    <parameter name="END_DATE" class="java.sql.Timestamp"/>
    <parameter name="PRODUCT_CODE" class="java.lang.String"/>
    <queryString>
        <![CDATA[
        SELECT
            p.code as codigoProduto,
            p.name as nomeProduto,
            c.name as categoria,
            sm.type as tipoMovimentacao,
            sm.quantity as quantidade,
            sm.unit_price as precoUnitario,
            (sm.quantity * sm.unit_price) as valorTotal,
            sm.movement_code as codigoMovimentacao,
            sm.note as observacao,
            s.name as fornecedor,
            cl.name as cliente,
            sm.created_at as dataMovimentacao,
            sm.created_by as criadoPor
        FROM stock_movements sm
        INNER JOIN products p ON sm.product_id = p.id
        INNER JOIN categories c ON p.category_id = c.id
        LEFT JOIN suppliers s ON sm.supplier_id = s.id
        LEFT JOIN clients cl ON sm.client_id = cl.id
        WHERE (CAST($P{TYPE} AS varchar) IS NULL OR upper(sm.type) = upper(CAST($P{TYPE} AS varchar)))
        AND (CAST($P{START_DATE} AS timestamp) IS NULL OR sm.created_at >= CAST($P{START_DATE} AS timestamp))
        AND (CAST($P{END_DATE} AS timestamp) IS NULL OR sm.created_at <= CAST($P{END_DATE} AS timestamp))
        AND (CAST($P{PRODUCT_CODE} AS varchar) IS NULL OR p.code = CAST($P{PRODUCT_CODE} AS varchar))
        ORDER BY sm.created_at DESC
        ]]>
    </queryString>
    <field name="codigoProduto" class="java.lang.String"/>
    <field name="nomeProduto" class="java.lang.String"/>
    <field name="categoria" class="java.lang.String"/>
    <field name="tipoMovimentacao" class="java.lang.String"/>
    <field name="quantidade" class="java.lang.Integer"/>
    <field name="precoUnitario" class="java.math.BigDecimal"/>
    <field name="valorTotal" class="java.math.BigDecimal"/>
    <field name="codigoMovimentacao" class="java.lang.String"/>
    <field name="observacao" class="java.lang.String"/>
    <field name="fornecedor" class="java.lang.String"/>
    <field name="cliente" class="java.lang.String"/>
    <field name="dataMovimentacao" class="java.sql.Timestamp"/>
    <field name="criadoPor" class="java.lang.String"/>
    <variable name="valorTotal_SUM" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{valorTotal}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
